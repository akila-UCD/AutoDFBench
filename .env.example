# AutoDFBench settings (all optional).
# No database server or credentials are needed: the ground truth ships as a SQLite file.
#
# Without Docker: copy this file to .env in the repository root and uncomment what you need.
# With Docker:    set the same variables under `environment:` in docker-compose.yml
#                 (.env files are not copied into the image).

# --- Storage ---
# AUTODFBENCH_GT_DB=ground_truth/autodfbench_gt.sqlite          # ground truth (read-only)
# AUTODFBENCH_RESULTS_DB=results/autodfbench_results.sqlite     # results written when write_db=true

# --- Ports (serve.py) ---
# AUTODFBENCH_BASE_PORT=8000                                    # APIs use BASE..BASE+4

# --- Source data not included in the repository ---
# CARVING_SOURCE_DIR=Data/source        # original files of the CFReDS "File Carving Graphic Files" (2023) data set
# MAIN_PATH=.                           # Windows registry ground truth is read from <MAIN_PATH>/Data/windows_registry (default: repository root)
# TEMP_FILE_UPLOAD_PATH=/tmp            # where uploaded files are stored while being scored

# --- File carving scoring parameters (defaults shown) ---
# GT_SELECT_STRATEGY=phash_first        # phash_first | hybrid | blocks
# PHASH_TOP_K=3
# PHASH_HASH_SIZE=8
# PHASH_HIGHFREQ=4
# Q_SIM_COMPLETE_PCT=0.5
# Q_SIM_MAJOR_PCT=0.1
